# Send the old Netlify subdomain to the primary custom domain (avoid duplicate
# site). Must be first so netlify.app/<path> goes to the .com host before the
# path rules below run. Only matches the netlify.app host, so no loop on .com.
https://artbycarlostattoo.netlify.app/*  https://artbycarlostattoo.com/:splat  301!

/fine-line-tattoos.html        /floral-tattoos.html  301
/fine-line-floral-tattoos.html /floral-tattoos.html  301

# Extensionless -> canonical .html. The "!" forces the 301 even though Netlify
# would otherwise auto-serve the .html file at this path (200), so old
# indexed/bookmarked extensionless URLs consolidate to the canonical .html.
/japanese-tattoos        /japanese-tattoos.html        301!
/bio-organic-tattoos     /bio-organic-tattoos.html     301!
/realism-tattoos         /bio-organic-tattoos.html     301!
/realism-tattoos.html    /bio-organic-tattoos.html     301!
/floral-tattoos          /floral-tattoos.html          301!
/watercolor-tattoos      /watercolor-tattoos.html      301!
/contact                 /contact.html                 301!
/traveling-for-a-tattoo  /traveling-for-a-tattoo.html  301!
/process                 /process.html                 301!

